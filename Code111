#include <Servo.h>

// Wing servos
Servo leftWing;   // Pin 9
Servo rightWing;  // Pin 10

void setup() {
  leftWing.attach(9);
  rightWing.attach(10);
}

void loop() {
  // Flap up (wings come together)
  for (int angle = 30; angle <= 120; angle++) {
    leftWing.write(angle);
    rightWing.write(180 - angle); // Mirror right wing
    delay(15);
  }

  // Flap down (wings open)
  for (int angle = 120; angle >= 30; angle--) {
    leftWing.write(angle);
    rightWing.write(180 - angle);
    delay(15);
  }
}
